# ============================================================================
# .env.docker — Template pour Docker
# ============================================================================
# Copier ce fichier en .env et remplir les valeurs
# cp .env.docker .env
# ============================================================================

# --- Provider LLM (obligatoire) ---
PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Sources web (optionnelles) ---
SEARXNG_URL=http://searxng:8080
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
SGAI_API_KEY=
GITHUB_TOKEN=

# --- Admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=your-strong-password
# ADMIN_TOTP_SECRET=

# --- Sécurité ---
# JWT_SECRET=your-jwt-secret
# PII_SALT=your-pii-salt

# --- Docker ---
COMPOSE_PROJECT_NAME=websearch
