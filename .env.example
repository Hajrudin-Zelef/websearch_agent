# Provider: "deepseek" ou "openrouter"
PROVIDER=deepseek

# Clé API DeepSeek (utilisée si PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Clé API OpenRouter (utilisée si PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Token GitHub (optionnel mais recommandé : 5000 req/h au lieu de 60)
GITHUB_TOKEN=ghp_your-github-token-here
