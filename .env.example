# Provider: "deepseek" ou "openrouter"
PROVIDER=deepseek

# Clé API DeepSeek (utilisée si PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Clé API OpenRouter (utilisée si PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Token GitHub (optionnel mais recommandé : 5000 req/h au lieu de 60)
GITHUB_TOKEN=ghp_your-github-token-here

# Clé API Perplexity (optionnelle — pour l'outil perplexity_search)
PERPLEXITY_API_KEY=your-perplexity-key-here

# Clé API Tavily (optionnelle — pour l'outil tavily_search)
TAVILY_API_KEY=your-tavily-key-here

# Clé API Brave Search (optionnelle — pour l'outil brave_search)
BRAVE_API_KEY=your-brave-key-here

# URL SearXNG (optionnelle — pour l'outil searxng_search, defaut: https://search.inetol.net)
SEARXNG_URL=https://search.inetol.net

# Clé API SearXNG (optionnelle — instance privee uniquement)
SEARXNG_API_KEY=

# Clé API Firecrawl (optionnelle — pour l'outil firecrawl_search)
FIRECRAWL_API_KEY=your-firecrawl-key-here

# Clé API ScrapeGraph AI (optionnelle — pour l'outil just_scrape_search)
SGAI_API_KEY=your-scrapegraph-key-here

# Chemin de la base SQLite pour les threads (optionnel — defaut: ./data/threads.db)
# THREADS_DB_PATH=/chemin/vers/threads.db
